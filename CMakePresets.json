{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "IndusPilot Dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INDUSPILOT_BUILD_CLIENT": "ON",
        "INDUSPILOT_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev-redis",
      "displayName": "IndusPilot Dev Redis",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-redis",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INDUSPILOT_BUILD_CLIENT": "OFF",
        "INDUSPILOT_BUILD_TESTS": "ON",
        "INDUSPILOT_WITH_REDIS": "ON"
      }
    },
    {
      "name": "dev-http",
      "displayName": "IndusPilot Dev HTTP",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-http",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INDUSPILOT_BUILD_CLIENT": "OFF",
        "INDUSPILOT_BUILD_TESTS": "ON",
        "INDUSPILOT_WITH_REDIS": "ON",
        "INDUSPILOT_WITH_DROGON": "ON"
      }
    },
    {
      "name": "dev-http-mongodb",
      "displayName": "IndusPilot Dev HTTP MongoDB",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev-http-mongodb",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_MAX_CONCURRENCY": "2"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INDUSPILOT_BUILD_CLIENT": "OFF",
        "INDUSPILOT_BUILD_TESTS": "ON",
        "INDUSPILOT_WITH_REDIS": "ON",
        "INDUSPILOT_WITH_DROGON": "ON",
        "INDUSPILOT_WITH_MONGODB": "ON",
        "VCPKG_MANIFEST_FEATURES": "mongodb",
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_ROOT}/installed"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-redis",
      "configurePreset": "dev-redis"
    },
    {
      "name": "dev-http",
      "configurePreset": "dev-http"
    },
    {
      "name": "dev-http-mongodb",
      "configurePreset": "dev-http-mongodb"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-redis",
      "configurePreset": "dev-redis",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "PATH": "$env{VCPKG_ROOT}/installed/x64-windows/debug/bin;$env{VCPKG_ROOT}/installed/x64-windows/bin;$penv{PATH}"
      }
    },
    {
      "name": "dev-http",
      "configurePreset": "dev-http",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "PATH": "$env{VCPKG_ROOT}/installed/x64-windows/debug/bin;$env{VCPKG_ROOT}/installed/x64-windows/bin;$penv{PATH}"
      }
    },
    {
      "name": "dev-http-mongodb",
      "configurePreset": "dev-http-mongodb",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "PATH": "$env{VCPKG_ROOT}/installed/x64-windows/debug/bin;$env{VCPKG_ROOT}/installed/x64-windows/bin;$penv{PATH}"
      }
    }
  ]
}
