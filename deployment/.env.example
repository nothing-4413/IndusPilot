# 本地演示密钥示例。生产环境必须替换为唯一强密钥，并避免提交真实 .env。
INDUSPILOT_MYSQL_ROOT_PASSWORD=change-me-root-password
INDUSPILOT_MYSQL_DATABASE=induspilot
INDUSPILOT_MYSQL_USER=induspilot
INDUSPILOT_MYSQL_PASSWORD=change-me-app-password
INDUSPILOT_MYSQL_BIND=127.0.0.1
INDUSPILOT_MYSQL_PORT=3306

INDUSPILOT_REDIS_PASSWORD=change-me-redis-password
INDUSPILOT_REDIS_BIND=127.0.0.1
INDUSPILOT_REDIS_PORT=6379

INDUSPILOT_MONGODB_ROOT_USER=induspilot
INDUSPILOT_MONGODB_ROOT_PASSWORD=change-me-mongodb-password
INDUSPILOT_MONGODB_DATABASE=induspilot
INDUSPILOT_MONGODB_BIND=127.0.0.1
INDUSPILOT_MONGODB_PORT=27017